DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/asd_intervention
REDIS_URL=redis://redis:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asd_intervention
APP_ENV=development
DEBUG=true

# Validation framework LLM config
# Anthropic example (recommended for quality):
# VALIDATION_MODEL=anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=your-key-here
#
# Ollama local example (use mistral:7b for low RAM; backend reaches host via host.docker.internal):
# VALIDATION_MODEL=ollama/mistral:7b
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_API_KEY=ollama
